@prefix : <http://www.example.com#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .

:Bob a :Person ;
    :age "18" ;
    :timeSpentAlive "18" ;
    :hasDog "Frank" ;
    :knows :Alice .

:Alice a :Person;
    :age "19" ;
    :hasDog "Casey" ;
    owl:sameAs :alice, :alicia, :al .

:age rdfs:subPropertyOf :yearsOld .

:timeSpentAlive rdfs:subPropertyOf :age .

:hasDog rdfs:subPropertyOf :hasAnimal .
