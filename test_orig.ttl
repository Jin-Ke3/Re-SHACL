@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

<http://www.example.com#PersonShape> a sh:NodeShape ;
    sh:closed true ;
    sh:ignoredProperties ( owl:sameAs ) ;
    sh:property [ sh:path <http://www.example.com#age> ],
        [ sh:path <http://www.example.com#timeSpentAlive> ],
        [ sh:minCount 1 ;
            sh:path <http://www.example.com#yearsOld> ],
        [ sh:minCount 1 ;
            sh:path <http://www.example.com#hasDog> ] ;
    sh:targetClass <http://www.example.com#Person> .

